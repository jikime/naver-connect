# Supabase 프로젝트 설정
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버에서만 사용하는 비밀 키입니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_SECRET_KEY=

# Dashboard > Connect > Session pooler (port 5432) 연결 문자열을 권장합니다.
# 서버·마이그레이션 전용이며 브라우저 번들에 포함하면 안 됩니다.
SUPABASE_DATABASE_URL=

# Auth.js v5
# 생성 예시: openssl rand -base64 33
AUTH_SECRET=
# v5는 일반 경로에서 AUTH_URL을 자동 추론합니다. 로컬 포트를 명시할 때만 사용합니다.
AUTH_URL=http://localhost:3005
# 리버스 프록시 뒤에서 실행할 때만 true로 설정합니다.
AUTH_TRUST_HOST=true

# 심사 환경에서만 기업가·전문가·운영자 테스트 계정을 로그인 화면에 표시합니다.
SHOW_REVIEW_ACCOUNTS=true
# 심사용 계정에 시드 추천·매칭 데이터를 연결합니다. 일반 운영 환경에서는 false로 두세요.
ENABLE_REVIEW_DATA=true
